# Build / test outputs.
test-logs/
nim-cache/
bench-results/

# reprobuild engine outputs — `repro build` / `repro test` write the test
# binaries named in repro.nim here, plus its own working state.
build/
.repro/

# direnv local state.
.direnv/

# Compiled test binaries.
tests/test_*
!tests/test_*.nim
!tests/test_*.cfg
tests/echo_packet_app
!tests/echo_packet_app.nim

# Nim caches.
*.dSYM
*.exe
*.pdb
nimcache/

# Generated by the hook manager as a symlink into the Nix store. Untracked
# and unignored, it left the repo permanently dirty.
.pre-commit-config.yaml
